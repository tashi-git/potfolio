<div class="portfolio">

  <!-- Navigation -->
  <header class="navbar">

    <div class="logo">
      TASHI WANGCHUK
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="#about">About</a>
      <a href="#skills">Skills</a>
      <a href="#projects">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#education">Education</a>
      <a href="#contact">Contact</a>
      
      <% if authenticated? %>
        <%= button_to "Logout", session_path, method: :delete, class: "logout-link"%>
      <% else %>
        <%= link_to "Login", new_session_path %>
      <% end %>

    </nav>

  </header>


  <!-- Main Content -->
  <main>

    <!-- Hero -->
    <section class="hero">

      <div class="hero-content">

        <p class="eyebrow">
          DEVELOPER / PORTFOLIO
        </p>

        <h1>
          Tashi Wangchuk
        </h1>

        <h2>
          I build. I learn. I keep improving.
        </h2>

        <p class="intro">
          I'm a developer with a passion for creating practical and meaningful software. From building web applications to exploring new technologies, I enjoy turning ideas into solutions that are simple, useful, and reliable.
        </p>

      </div>


      <!-- Profile Photo -->
      <div class="hero-card">

        <%= image_tag "profile.jpeg", class: "profile-photo" %>

        <p>
          Building today. Learning tomorrow.
        </p>

      </div>

    </section>


    <!-- About -->
    <section id="about">

      <p class="section-label">
        ABOUT
      </p>

      <h2>
        About me
      </h2>

      <p>
        I'm an IT developer who enjoys building practical software and learning new technologies. I like turning ideas into simple, useful applications while continuously improving my skills.
        <br> My interests include web development, backend development, databases, and software engineering. I have worked with technologies such as Ruby, Rails, Python, Django, Flask, JavaScript, CSharp, PostgreSQL, and Odoo.
        I value clean code, simple solutions, and continuous learning.
      </p>

    </section>


    <!-- Skills -->
    <section id="skills">

      <p class="section-label">
        SKILLS
      </p>

      <h2>
        Skills
      </h2>

      <% if authenticated? %>
        <%= link_to "New Skill", new_skill_path %>
      <% end %>

      <div class="skills-list">

        <% @skills.each do |skill| %>

          <div class="skill-item">

            <h3>
              <%= skill.name %>
            </h3>

            <p>
              <%= skill.category %>
            </p>

            <% if authenticated? %>
              <%= link_to "Edit", edit_skill_path(skill) %>
            <% end %>

          </div>

        <% end %>

      </div>

    </section>


    <!-- Projects -->
    <section id="projects">

      <p class="section-label">
        PROJECTS
      </p>

      <h2>
        Projects
      </h2>

      <% if authenticated? %>
        <%= link_to "New Project", new_project_path %>
      <% end %>

      <div class="projects-list">

        <% @projects.each do |project| %>

          <div class="project-item">

            <h3>
              <%= project.title %>
            </h3>

            <p>
              <%= project.description %>
            </p>

            <% if project.github_url.present? %>
              <a href="<%= project.github_url %>" target="_blank">
                GitHub →
              </a>
            <% end %>

            <% if authenticated? %>
              <%= link_to "Edit", edit_project_path(project) %>
            <% end %>

          </div>

        <% end %>

      </div>

    </section>


    <!-- Experience -->
    <section id="experience">

      <p class="section-label">
        EXPERIENCE
      </p>

      <h2>
        Experience
      </h2>

      <% if authenticated? %>
        <%= link_to "New Experience", new_experience_path %>
      <% end %>

      <div class="experience-list">

        <% @experiences.each do |experience| %>

          <div class="experience-item">

            <h3>
              <%= experience.position %>
            </h3>

            <p class="company">
              <%= experience.company %>
            </p>

            <p>
              <%= experience.description %>
            </p>

            <% if authenticated? %>
              <%= link_to "Edit", edit_experience_path(experience) %>
            <% end %>

          </div>

        <% end %>

      </div>

    </section>


    <!-- Education -->
    <section id="education">

      <p class="section-label">
        EDUCATION
      </p>

      <h2>
        Education
      </h2>

      <% if authenticated? %>
        <%= link_to "New Education", new_education_path %>
      <% end %>

      <div class="education-list">

        <% @educations.each do |education| %>

          <div class="education-item">

            <h3>
              <%= education.qualification %>
            </h3>

            <p>
              <%= education.institution %>
            </p>

            <% if authenticated? %>
              <%= link_to "Edit", edit_education_path(education) %>
            <% end %>

          </div>

        <% end %>

      </div>

    </section>


    <!-- Contact -->
    <section id="contact">

      <p class="section-label">
        CONTACT
      </p>

      <h2>
        Let's connect.
      </h2>

      <p>
        I'm open to new opportunities, collaborations, and interesting
        projects. Whether you have a question or simply want to connect,
        I'd be happy to hear from you.
        <br> <br>
        Email: tashi3037@gmail.com <br>
        GitHub: tashi-git <br>
        LinkedIn: Tashi Wangchuk

      </p>

    </section>

  </main>


  <!-- Footer -->
  <footer>

    <p>
      © <%= Time.current.year %> Tashi Wangchuk.
    </p>

  </footer>

</div>