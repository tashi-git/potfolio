<div class="form-container">
  <h1>New Experience</h1>

  <%= form_with model: @experience do |form| %>

    <div class="form-group">
      <%= form.label :company %>
      <%= form.text_field :company, placeholder: "e.g. DrukSmart Private Limited" %>
    </div>

    <div class="form-group">
      <%= form.label :position %>
      <%= form.text_field :position, placeholder: "e.g. Software Developer Intern" %>
    </div>

    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description, placeholder: "Describe your experience..." %>
    </div>

    <%= form.submit "Create Experience", class: "form-submit" %>

  <% end %>
</div>