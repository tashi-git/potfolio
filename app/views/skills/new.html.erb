<div class="form-container">
  <h1>New Skill</h1>

  <%= form_with model: @skill do |form| %>

    <div class="form-group">
      <%= form.label :name %>
      <%= form.text_field :name, placeholder: "e.g. Ruby" %>
    </div>

    <div class="form-group">
      <%= form.label :category %>
      <%= form.text_field :category, placeholder: "e.g. Programming" %>
    </div>

    <%= form.submit "Create Skill", class: "form-submit" %>

  <% end %>
</div>