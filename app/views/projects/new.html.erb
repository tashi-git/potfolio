<h1>New Project</h1>

<%= form_with model: @project do |form| %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :github_url %>
    <%= form.text_field :github_url %>
  </div>

  <div>
    <%= form.submit "Create Project" %>
  </div>

<% end %>