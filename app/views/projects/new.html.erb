<div class="form-container">
  <h1>New Project</h1>

  <%= form_with model: @project do |form| %>

    <div class="form-group">
      <%= form.label :title %>
      <%= form.text_field :title, placeholder: "e.g. Portfolio Website" %>
    </div>

    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description, placeholder: "Describe your project..." %>
    </div>

    <div class="form-group">
      <%= form.label :github_url %>
      <%= form.text_field :github_url, placeholder: "https://github.com/..." %>
    </div>

    <%= form.submit "Create Project", class: "form-submit" %>

  <% end %>
</div>